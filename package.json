{
  "name": "zoningviz",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @zoningviz/web dev",
    "build": "pnpm --filter @zoningviz/web build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "parcel": "tsx packages/jurisdictions/sf/cli.ts",
    "envelope": "tsx packages/jurisdictions/sf/envelope-cli.ts",
    "record-fixtures": "tsx scripts/record-engine-fixtures.mts",
    "e2e": "pnpm --filter @zoningviz/web e2e"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
