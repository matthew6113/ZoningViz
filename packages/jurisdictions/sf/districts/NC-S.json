{
  "jurisdiction": "sf",
  "district": "NC-S",
  "name": "Neighborhood Commercial, Shopping Center",
  "rules": [
    {
      "id": "use",
      "kind": "info",
      "title": "Shops with homes above",
      "plain": "NC-S lots are for neighborhood shopping centers, with homes allowed: up to one home per 800 square feet of lot area, or the density of the nearest residential district if that is greater (that comparison isn't shown).",
      "params": {},
      "citation": "§713 (Table 713), §207(b)(6)",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-7-neighborhood-commercial-districts",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "height-reference",
      "kind": "height_reference",
      "title": "Where height is measured from",
      "plain": "Height is measured from the curb at the middle of the building's street front. On a lot that slopes up from the street, only the first 10 feet back are measured from the curb, and the rest from the average ground at the two sides of each cross-section; on a lot that slopes down, the curb is used for the first 100 feet.",
      "params": {
        "downslopeCurbDepthFeet": 100,
        "upslopeCurbWithinFeet": 10
      },
      "citation": "§260(a)(1)(A)–(C), §261(a)",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21453",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "mapped-height",
      "kind": "height_cap",
      "title": "Height limit",
      "plain": "No part of a building may be taller than the height limit mapped for this lot's height and bulk district.",
      "params": {
        "source": "heightDistrict"
      },
      "citation": "§250",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21392",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "ground-floor",
      "kind": "ground_story",
      "title": "Ground floor height",
      "plain": "A shop or other non-residential ground floor must be at least 14 feet from floor to floor, or 10 feet in 40- and 50-foot height districts.",
      "params": {
        "minFloorToFloorFeet": 14,
        "exceptions": [
          {
            "heightDistrictFeet": [
              40,
              50
            ],
            "minFloorToFloorFeet": 10
          }
        ]
      },
      "citation": "§145.1(c)(4)(C)",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-1.2-dimensions-areas-and-open-spaces/sec.-145.-frontages-outdoor-activity-areas-walkup-facilities-and-ground-floor-uses-and-standa/sec.-145.1.-street-frontages-in-neighborhood-commercial-residential-commercial-commercial-and",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "rear-yard",
      "kind": "rear_yard",
      "title": "Rear yard",
      "plain": "The back 25% of the lot, and never less than 15 feet, must stay open from the second story up, and at ground level too if the first story has homes.",
      "params": {
        "pctOfLotDepth": 0.25,
        "minFeet": 15,
        "appliesAt": "above_first_story"
      },
      "citation": "§134(c)(2), §134(d)(2); Table 713",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-18322",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "bulk",
      "kind": "bulk",
      "title": "Bulk limits",
      "plain": "Above a height set by the lot's bulk district (the letter after the height, as in 65-A), no floor may be longer, or longer corner to corner, than the district allows.",
      "params": {
        "letters": {
          "A": {
            "aboveFeet": 40,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "B": {
            "aboveFeet": 50,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "C": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "D": {
            "aboveFeet": 40,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "E": {
            "aboveFeet": 65,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "F": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "G": {
            "aboveFeet": 80,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "H": {
            "aboveFeet": 100,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "I": {
            "aboveFeet": 150,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "J": {
            "aboveFeet": 40,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "K": {
            "aboveFeet": 60,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "L": {
            "aboveFeet": 80,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "M": {
            "aboveFeet": 100,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "N": {
            "aboveFeet": 40,
            "lengthFeet": 50,
            "diagonalFeet": 100
          },
          "T": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 125
          }
        },
        "noLimit": [
          "X"
        ],
        "podiumOnly": {
          "R-4": 85
        }
      },
      "citation": "§270(a), Table 270; §102 (Plan Dimensions); §270(i)",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-2.5-height-and-bulk-districts",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "far",
      "kind": "far",
      "title": "Floor area for non-residential uses",
      "plain": "Shops, offices and other non-residential uses may have floor area up to 1.8 times the lot area; homes don't count toward this limit.",
      "params": {
        "ratio": 1.8,
        "appliesTo": "non_residential"
      },
      "citation": "§124(a)–(b), Table 124; Table 713",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-1.2-dimensions-areas-and-open-spaces/sec.-124.-basic-floor-area-ratio",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "front-setback",
      "kind": "flag",
      "title": "Sidewalk setback",
      "plain": "Where the sidewalk is narrower than the Better Streets Plan recommends, a lot with 50 feet or more of frontage, a corner lot or a lot next to a set-back building must set its first 15 feet of height back to widen the sidewalk; sidewalk widths aren't in this app's data.",
      "params": {},
      "citation": "§132(e)",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-1.2-dimensions-areas-and-open-spaces/sec.-132.-front-setback-areas-in-rto-rh-and-rm-districts-and-for-required-setbacks-for-project",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "narrow-street",
      "kind": "flag",
      "title": "Narrow streets",
      "plain": "On a street 40 feet wide or narrower, upper stories may have to step back from the front; street widths aren't in this app's data, so that isn't shown.",
      "params": {},
      "citation": "§261.1",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21519",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "cross-slope",
      "kind": "flag",
      "title": "Cross-slope",
      "plain": "Where the street or the ground slopes across the lot by more than 5%, a wide building is measured from several points, each covering a limited width (65 feet or less, narrower on steeper slopes); this view measures from one point.",
      "params": {},
      "citation": "§260(a)(3), Table 260-1",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21453",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "large-lot",
      "kind": "flag",
      "title": "Large lots",
      "plain": "On a lot of two acres or more, a limit of 65% lot coverage from the second story up, with 35% of the lot left unbuilt, replaces the rear yard; that isn't shown.",
      "params": {},
      "citation": "§134(l)",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-18322",
      "verified": false,
      "effectiveDate": null
    }
  ]
}
