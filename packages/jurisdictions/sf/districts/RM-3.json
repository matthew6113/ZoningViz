{
  "jurisdiction": "sf",
  "district": "RM-3",
  "name": "Residential, Mixed, Medium Density",
  "rules": [
    {
      "id": "use",
      "kind": "info",
      "title": "Homes, one per 400 sq ft of lot",
      "plain": "RM-3 lots are for homes of any building type, up to one unit per 400 square feet of lot area, plus accessory units. Each unit needs 60 square feet of private or 80 square feet of shared open space.",
      "params": {},
      "citation": "§209.2 (Table 209.2), §207, Table 135A",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-2-use-districts/sec.-209.-description-and-purpose-of-residential-and-residential-commercial-districts/sec.-209.2.-rm-residential-mixed-districts",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "height-reference",
      "kind": "height_reference",
      "title": "Where height is measured from",
      "plain": "Height is measured from the curb at the middle of the building's street front. On a lot that slopes up from the street, only the first 10 feet back are measured from the curb, and the rest from the average ground at the two sides of each cross-section; on a lot that slopes down, the curb is used for the first 100 feet.",
      "params": {
        "downslopeCurbDepthFeet": 100,
        "upslopeCurbWithinFeet": 10
      },
      "citation": "§260(a)(1)(A)–(C), §261(a)",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21453",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "mapped-height",
      "kind": "height_cap",
      "title": "Height limit",
      "plain": "No part of a building may be taller than the height limit mapped for this lot's height and bulk district.",
      "params": {
        "source": "heightDistrict"
      },
      "citation": "§250",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21392",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "rear-yard",
      "kind": "rear_yard",
      "title": "Rear yard",
      "plain": "The back 25% of the lot, and never less than 15 feet, must stay open at ground level and on every floor.",
      "params": {
        "pctOfLotDepth": 0.25,
        "minFeet": 15,
        "appliesAt": "grade_and_every_story"
      },
      "citation": "§134(c)(2), §134(d)(1)",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-18322",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "front-setback",
      "kind": "front_setback",
      "title": "Front setback",
      "plain": "The building must step back from the front lot line as far as the neighboring building with the shallower setback, up to 10 feet (15 feet on some block faces, not shown).",
      "params": {
        "method": "shallowest_adjacent",
        "maxFeet": 10,
        "userOverride": true
      },
      "citation": "§132(a), (c), (d)",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-18248",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "bulk",
      "kind": "bulk",
      "title": "Bulk limits",
      "plain": "Above a height set by the lot's bulk district (the letter after the height, as in 65-A), no floor may be longer, or longer corner to corner, than the district allows.",
      "params": {
        "letters": {
          "A": {
            "aboveFeet": 40,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "B": {
            "aboveFeet": 50,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "C": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 125
          },
          "D": {
            "aboveFeet": 40,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "E": {
            "aboveFeet": 65,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "F": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 140
          },
          "G": {
            "aboveFeet": 80,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "H": {
            "aboveFeet": 100,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "I": {
            "aboveFeet": 150,
            "lengthFeet": 170,
            "diagonalFeet": 200
          },
          "J": {
            "aboveFeet": 40,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "K": {
            "aboveFeet": 60,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "L": {
            "aboveFeet": 80,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "M": {
            "aboveFeet": 100,
            "lengthFeet": 250,
            "diagonalFeet": 300
          },
          "N": {
            "aboveFeet": 40,
            "lengthFeet": 50,
            "diagonalFeet": 100
          },
          "T": {
            "aboveFeet": 80,
            "lengthFeet": 110,
            "diagonalFeet": 125
          }
        },
        "noLimit": [
          "X"
        ],
        "podiumOnly": {
          "R-4": 85
        }
      },
      "citation": "§270(a), Table 270; §102 (Plan Dimensions); §270(i)",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-2.5-height-and-bulk-districts",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "far",
      "kind": "far",
      "title": "Floor area for non-residential uses",
      "plain": "Shops, offices and other non-residential uses may have floor area up to 3.6 times the lot area; homes don't count toward this limit.",
      "params": {
        "ratio": 3.6,
        "appliesTo": "non_residential"
      },
      "citation": "§124(a)–(b), Table 124; Table 209.2",
      "url": "https://gocodebook.com/library/us/ca/san-francisco-planning/article-1.2-dimensions-areas-and-open-spaces/sec.-124.-basic-floor-area-ratio",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "narrow-street",
      "kind": "flag",
      "title": "Narrow streets",
      "plain": "On a street 40 feet wide or narrower, upper stories may have to step back from the front; street widths aren't in this app's data, so that isn't shown.",
      "params": {},
      "citation": "§261.1",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21519",
      "verified": false,
      "effectiveDate": null
    },
    {
      "id": "cross-slope",
      "kind": "flag",
      "title": "Cross-slope",
      "plain": "Where the street or the ground slopes across the lot by more than 5%, a wide building is measured from several points, each covering a limited width (65 feet or less, narrower on steeper slopes); this view measures from one point.",
      "params": {},
      "citation": "§260(a)(3), Table 260-1",
      "url": "https://codelibrary.amlegal.com/codes/san_francisco/latest/sf_planning/0-0-0-21453",
      "verified": false,
      "effectiveDate": null
    }
  ]
}
